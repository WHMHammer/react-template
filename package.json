{
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "license": "AGPL-3.0-only",
  "name": "react-template",
  "private": true,
  "scripts": {
    "build": "npm run build:dev",
    "build:dev": "tsc --build && vite build --mode development",
    "build:prod": "tsc --build --force && vite build --mode production",
    "lint": "biome check --write",
    "postinstall": "playwright install",
    "prepare": "husky",
    "preview": "npm run preview:dev",
    "preview:dev": "vite preview --mode development",
    "preview:prod": "vite preview --mode production",
    "start": "vite --mode development",
    "test": "vitest run"
  },
  "type": "module",
  "version": "0.0.0"
}
